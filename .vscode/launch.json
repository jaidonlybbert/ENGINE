{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "C++ Launch (CMake)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/Debug/Engine",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "text": "handle SIGSEGV stop print",
                    "description": "Stop on SIGSEV",
                    "ignoreFailures": false
                },
                {
                    "text": "handle SIGABRT stop print",
                    "description": "Stop on SIGABRT",
                    "ignoreFailures": false
                }
            ]
        }
    ]
}