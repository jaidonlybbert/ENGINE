{
  "version": 5,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 1
  },
  "include": [
    "build/generators/CMakePresets.json"
  ],
  "configurePresets": [
    {
      "name": "default",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_CXX_STANDARD": "20",
        "CMAKE_CXX_STANDARD_REQUIRED": "True"
      }
    },
    {
      "name": "gcc14-debug",
      "displayName": "GCC 14 Debug",
      "description": "Build using GCC 14",
      "binaryDir": "${sourceDir}/build",
      "environment": {
        "CC": "gcc-14",
        "CXX": "g++-14"
      },
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_CXX_STANDARD": "20",
        "CMAKE_CXX_STANDARD_REQUIRED": "True"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "default",
      "description": "Build using default preset",
      "jobs": 8
    },
    {
      "name": "gcc14-debug",
      "configurePreset": "gcc14-debug",
      "description": "Build using gcc14 preset",
      "jobs": 8
    }
  ]
}