[settings]
os=Windows
arch=x86_64
compiler=msvc
compiler.version=193
compiler.cppstd=20
compiler.runtime=dynamic
build_type=Release
[conf]
# CMake's "Visual Studio 17 2022" generator (Conan's default here) fails to locate the
# VS install on the CI runner even with a Developer Command Prompt environment set up.
# Ninja sidesteps that lookup entirely (it just needs cl.exe/link.exe on PATH) and, as a
# single-config generator, also makes the generated CMake presets match the Ubuntu
# jobs' conan-release/conan-debug naming instead of MSVC's split
# conan-default(configure)/conan-release(build) presets.
tools.cmake.cmaketoolchain:generator=Ninja
# Even with Ninja (no VS project generator involved), Conan's own toolchain generation
# separately locates a VS install (to write a conanvcvars.bat) via `vswhere`, which shells
# out and reads the ProgramFiles(x86) env var itself - that lookup does not reliably
# succeed for steps running under bash on this runner (asserting just the version number,
# tools.microsoft.msbuild:vs_version, was not enough - it still needs to find the path).
# Give it the actual install path directly, bypassing detection entirely. This is the
# fixed location of VS2022 Enterprise on GitHub's windows-latest runner image.
tools.microsoft.msbuild:installation_path=C:\Program Files\Microsoft Visual Studio\2022\Enterprise
