# Copy this file to docker/.env and fill in real values:
#   cp docker/.env.example docker/.env
# docker/.env is gitignored - never commit it. See docker/README.md for guidance on
# scoping these credentials before you fill them in.

# Recommended if you're authenticating with a Claude Pro/Max/Team/Enterprise subscription
# (no API key needed - see docker/README.md's "Authenticating Claude Code" section). Run
# `claude setup-token` once, anywhere you already have Claude Code logged in (e.g. your own
# host machine - it just needs a browser), and paste the token it prints here. Every agent
# container then authenticates as your subscription with no per-container login step.
CLAUDE_CODE_OAUTH_TOKEN=

# Optional, and NOT needed alongside CLAUDE_CODE_OAUTH_TOKEN above - only set this if you'd
# rather bill this container's usage to an Anthropic API key instead of a subscription.
# Careful: if both this and CLAUDE_CODE_OAUTH_TOKEN (or a subscription login from
# `claude`/`/login`) are present, Claude Code prefers THIS one - leave it blank unless
# that's what you want. If you do set it, use a key with a usage budget/limit configured in
# the Anthropic Console (Settings -> Limits), separate from your personal/org default key,
# so a misbehaving agent has a hard spending ceiling:
# https://console.anthropic.com/settings/limits
ANTHROPIC_API_KEY=

# Optional. A GitHub fine-grained personal access token (not a classic PAT, not your own
# login token), scoped to ONLY this repository, with the minimum permissions the agent
# actually needs - typically just "Contents: Read and write" and "Pull requests: Read and
# write". Leave empty if agents should only read the repo, not push branches or open PRs.
# https://github.com/settings/personal-access-tokens/new
GITHUB_TOKEN=

# Which repo/branch each agent clones into its own isolated workspace volume on first
# start (see docker/README.md - this is never a bind mount of your host checkout). Point
# this at a fork if you don't want agents pushing branches directly to the upstream repo.
REPO_URL=https://github.com/jaidonlybbert/ENGINE.git
REPO_BRANCH=main

# Optional. Defaults to "agent1"/"agent2" (per-container) if left unset.
GIT_AUTHOR_NAME=
GIT_AUTHOR_EMAIL=
